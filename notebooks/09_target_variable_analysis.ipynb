    "            color='darkorange', fontweight='bold')\n",
    "\n",
    "ax.set_xlabel('Month')\n",
    "ax.set_ylabel('Liquidation events')\n",
    "ax.set_title('Aave V2 liquidation events over time\\n'\n",
    "             '(spikes near known market crashes = market-driven component)')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../reports/figures/liquidation_timeline.png', dpi=150, bbox_inches='tight')\n",
